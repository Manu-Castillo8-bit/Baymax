<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Asistente.MainPage"
             BackgroundColor="#0B1120">

    <Grid>

        <!-- ========================================= -->
        <!-- CONTENIDO PRINCIPAL                       -->
        <!-- ========================================= -->

        <Grid RowDefinitions="Auto, Auto, *, Auto"
              Padding="20"
              RowSpacing="15">

            <!-- 1. NÚCLEO TECNOLÓGICO Y ANILLOS HUD -->
            <Grid Grid.Row="0"
                  HeightRequest="220"
                  WidthRequest="220"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">

                <!-- Glow -->
                <Ellipse x:Name="GlowEffect"
                         WidthRequest="160"
                         HeightRequest="160"
                         Fill="#22D3EE"
                         Opacity="0.15"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Anillo exterior -->
                <Ellipse x:Name="OuterRing1"
                         WidthRequest="210"
                         HeightRequest="210"
                         Stroke="#22D3EE"
                         StrokeThickness="1.5"
                         StrokeDashArray="12, 6, 2, 6"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Segundo anillo -->
                <Ellipse x:Name="OuterRing2"
                         WidthRequest="180"
                         HeightRequest="180"
                         Stroke="#164E63"
                         StrokeThickness="2"
                         StrokeDashArray="1, 8, 20, 5"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Anillo medio -->
                <Ellipse x:Name="MidRing"
                         WidthRequest="140"
                         HeightRequest="140"
                         Stroke="#22D3EE"
                         StrokeThickness="3"
                         StrokeDashArray="4, 12"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Anillo interior -->
                <Ellipse x:Name="InnerRing"
                         WidthRequest="100"
                         HeightRequest="100"
                         Stroke="#38BDF8"
                         StrokeThickness="1"
                         StrokeDashArray="2, 3"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Núcleo -->
                <Border x:Name="CoreCenter"
                        WidthRequest="60"
                        HeightRequest="60"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>

                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5"
                                             Radius="0.5">

                            <GradientStop Color="#E0F2FE"
                                          Offset="0.0" />

                            <GradientStop Color="#38BDF8"
                                          Offset="0.4" />

                            <GradientStop Color="#2563EB"
                                          Offset="0.8" />

                            <GradientStop Color="Transparent"
                                          Offset="1.0" />

                        </RadialGradientBrush>
                    </Border.Background>

                </Border>

                <!-- Esquinas HUD -->
                <Path Data="M 0,20 L 0,0 L 20,0
                            M 200,0 L 220,0 L 220,20
                            M 220,200 L 220,220 L 200,220
                            M 0,200 L 0,220 L 20,220"
                      Stroke="#22D3EE"
                      StrokeThickness="1.5"
                      Opacity="0.5"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"/>

            </Grid>


            <!-- ========================================= -->
            <!-- 2. MENSAJE DEL ASISTENTE                   -->
            <!-- ========================================= -->

            <Frame Grid.Row="1"
                   BackgroundColor="#111C30"
                   BorderColor="#22D3EE"
                   CornerRadius="12"
                   HasShadow="False"
                   Padding="15">

                <Label x:Name="AiMessageLabel"
                       Text="Núcleo activado. Sincronizando datos con el servidor..."
                       FontSize="18"
                       TextColor="#E2E8F0"
                       FontFamily="Arial"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

            </Frame>


            <!-- ========================================= -->
            <!-- 3. LISTA DE TAREAS                         -->
            <!-- ========================================= -->

            <CollectionView Grid.Row="2"
                            x:Name="TasksCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="OnTaskTapped">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame Margin="0,4"
                               Padding="12"
                               CornerRadius="8"
                               BackgroundColor="#111827"
                               BorderColor="#245B78">

                            <Grid ColumnDefinitions="*, Auto">

                                <!-- Información de tarea -->
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="3">

                                    <Label Text="{Binding Titulo}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="#E2E8F0"/>

                                    <Label Text="{Binding FechaVencimiento, StringFormat='Vence: {0:dd/MM/yyyy}'}"
                                           FontSize="11"
                                           TextColor="#64748B"/>

                                    <Label Text="{Binding FrecuenciaRecordatorioHoras, StringFormat='🔔 Recordar cada {0} horas', TargetNullValue='Sin recordatorio'}"
                                           FontSize="10"
                                           TextColor="#E2E8F0"/>

                                    <Label Text="{Binding Estado}"
                                           TextColor="#94A3B8"
                                           FontSize="12"/>

                                </VerticalStackLayout>


                                <!-- ================================= -->
                                <!-- BOTONES CRUD                       -->
                                <!-- ================================= -->

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="6">

                                    <!-- Completar -->
                                    <Button Text="Completar"
                                            Clicked="OnToggleCompleteClicked"
                                            BackgroundColor="#172554"
                                            BorderColor="#22D3EE"
                                            BorderWidth="1"
                                            TextColor="#22D3EE"
                                            FontSize="11"
                                            Padding="8,4"
                                            CornerRadius="4"/>

                                    <!-- Editar -->
                                    <Button Text="✏️"
                                            Clicked="OnEditTaskClicked"
                                            BackgroundColor="#111C30"
                                            BorderColor="#245B78"
                                            BorderWidth="1"
                                            TextColor="#38BDF8"
                                            FontSize="12"
                                            Padding="8,4"
                                            CornerRadius="4"/>

                                    <!-- Eliminar -->
                                    <Button Text="🗑️"
                                            Clicked="OnDeleteTaskClicked"
                                            BackgroundColor="#172554"
                                            BorderColor="#3B82F6"
                                            BorderWidth="1"
                                            TextColor="#3B82F6"
                                            FontSize="12"
                                            Padding="8,4"
                                            CornerRadius="4"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- ========================================= -->
            <!-- 4. BOTONES DE ACCIÓN                       -->
            <!-- ========================================= -->

            <Grid Grid.Row="3"
                  RowDefinitions="Auto, Auto"
                  RowSpacing="10">

                <HorizontalStackLayout Spacing="12"
                                       HorizontalOptions="Center">

                    <!-- Nueva tarea -->
                    <Button Text="+ Nueva Tarea"
                            Clicked="OnAddTaskClicked"
                            BackgroundColor="#2563EB"
                            TextColor="#E2E8F0"
                            FontAttributes="Bold"
                            CornerRadius="6"/>

                    <!-- Resumen -->
                    <Button Text="Resumen de hoy"
                            Clicked="OnGetSummaryClicked"
                            BackgroundColor="#172554"
                            BorderColor="#245B78"
                            BorderWidth="1"
                            TextColor="#22D3EE"
                            FontAttributes="Bold"
                            CornerRadius="6"/>

                </HorizontalStackLayout>


                <!-- Actualizar -->
                <Button Grid.Row="1"
                        Text="🔄 Actualizar / Sincronizar"
                        Clicked="OnRefreshClicked"
                        BackgroundColor="#172554"
                        BorderColor="#245B78"
                        BorderWidth="1"
                        TextColor="#22D3EE"
                        FontAttributes="Bold"
                        CornerRadius="6"/>

            </Grid>

        </Grid>


        <!-- ========================================= -->
        <!-- POPUP NUEVA TAREA / EDITAR TAREA          -->
        <!-- ========================================= -->

        <Grid x:Name="TareaPopupOverlay"
              IsVisible="False"
              BackgroundColor="#0B1120">

            <ScrollView>

                <Grid Padding="30"
                      RowSpacing="15"
                      VerticalOptions="Center"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">


                    <!-- ENCABEZADO -->
                    <Label Grid.Row="0"
                           x:Name="PopupHeaderLabel"
                           Text="Registrar Nueva Tarea"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#22D3EE"
                           HorizontalOptions="Center"/>


                    <!-- TÍTULO DE LA TAREA -->
                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="6">

                        <Label Text="Título de la tarea"
                               FontAttributes="Bold"
                               TextColor="#E2E8F0"
                               FontSize="14"/>

                        <Entry x:Name="PopupTituloEntry"
                               Placeholder="¿Qué deseas registrar?"
                               PlaceholderColor="#64748B"
                               BackgroundColor="#111C30"
                               TextColor="#E2E8F0"/>

                    </VerticalStackLayout>


                    <!-- FECHA DE VENCIMIENTO -->
                    <VerticalStackLayout Grid.Row="2"
                                         Spacing="6">

                        <Label Text="Fecha de vencimiento"
                               FontAttributes="Bold"
                               TextColor="#E2E8F0"
                               FontSize="14"/>

                        <DatePicker x:Name="PopupFechaPicker"
                                    BackgroundColor="#111C30"
                                    TextColor="#22D3EE"/>

                    </VerticalStackLayout>


                    <!-- FRECUENCIA DE RECORDATORIO -->
                    <VerticalStackLayout Grid.Row="3"
                                         Spacing="6">

                        <Label Text="Cada cuánto quieres recibir el recordatorio"
                               FontAttributes="Bold"
                               TextColor="#E2E8F0"
                               FontSize="14"/>

                        <Label Text="Selecciona la frecuencia de tus notificaciones:"
                               FontSize="12"
                               TextColor="#94A3B8"/>

                        <Picker x:Name="PopupFrecuenciaPicker"
                                BackgroundColor="#111C30"
                                Title="Frecuencia de recordatorio"
                                TextColor="#E2E8F0"/>

                    </VerticalStackLayout>


                    <!-- GUARDAR -->
                    <Button x:Name="PopupBotonGuardar"
                            Grid.Row="4"
                            Text="✔ Guardar Tarea"
                            Clicked="OnPopupGuardarClicked"
                            BackgroundColor="#2563EB"
                            TextColor="#E2E8F0"
                            FontAttributes="Bold"
                            CornerRadius="6"/>


                    <!-- CANCELAR -->
                    <Button Grid.Row="5"
                            Text="Cancelar"
                            Clicked="OnPopupCancelarClicked"
                            BackgroundColor="#172554"
                            BorderColor="#245B78"
                            BorderWidth="1"
                            TextColor="#22D3EE"
                            CornerRadius="6"/>

                </Grid>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>