<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Asistente.MainPage"
             BackgroundColor="#0B1120"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- ========================================= -->
        <!-- CONTENIDO PRINCIPAL                       -->
        <!-- ========================================= -->

        <Grid RowDefinitions="Auto, Auto, *, Auto"
              Padding="20"
              RowSpacing="15">

            <!-- 1. NÚCLEO TECNOLÓGICO Y ANILLOS HUD -->
            <Grid Grid.Row="0"
                  HeightRequest="220"
                  WidthRequest="220"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">

                <!-- Glow -->
                <Ellipse x:Name="GlowEffect"
                         WidthRequest="160"
                         HeightRequest="160"
                         Fill="#22D3EE"
                         Opacity="0.15"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Anillo exterior -->
                <Ellipse x:Name="OuterRing1"
                         WidthRequest="210"
                         HeightRequest="210"
                         Stroke="#22D3EE"
                         StrokeThickness="1.5"
                         StrokeDashArray="12, 6, 2, 6"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Segundo anillo -->
                <Ellipse x:Name="OuterRing2"
                         WidthRequest="180"
                         HeightRequest="180"
                         Stroke="#164E63"
                         StrokeThickness="2"
                         StrokeDashArray="1, 8, 20, 5"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Anillo medio -->
                <Ellipse x:Name="MidRing"
                         WidthRequest="140"
                         HeightRequest="140"
                         Stroke="#22D3EE"
                         StrokeThickness="3"
                         StrokeDashArray="4, 12"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Anillo interior -->
                <Ellipse x:Name="InnerRing"
                         WidthRequest="100"
                         HeightRequest="100"
                         Stroke="#38BDF8"
                         StrokeThickness="1"
                         StrokeDashArray="2, 3"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <!-- Núcleo -->
                <Border x:Name="CoreCenter"
                        WidthRequest="60"
                        HeightRequest="60"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>

                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5"
                                             Radius="0.5">

                            <GradientStop Color="#E0F2FE"
                                          Offset="0.0" />

                            <GradientStop Color="#38BDF8"
                                          Offset="0.4" />

                            <GradientStop Color="#2563EB"
                                          Offset="0.8" />

                            <GradientStop Color="Transparent"
                                          Offset="1.0" />

                        </RadialGradientBrush>
                    </Border.Background>

                </Border>

                <!-- Esquinas HUD -->
                <Path Data="M 0,20 L 0,0 L 20,0
                            M 200,0 L 220,0 L 220,20
                            M 220,200 L 220,220 L 200,220
                            M 0,200 L 0,220 L 20,220"
                      Stroke="#22D3EE"
                      StrokeThickness="1.5"
                      Opacity="0.5"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"/>

            </Grid>


            <!-- ========================================= -->
            <!-- 2. MENSAJE DEL ASISTENTE                   -->
            <!-- ========================================= -->

            <Frame Grid.Row="1"
                   BackgroundColor="#111C30"
                   BorderColor="#22D3EE"
                   CornerRadius="12"
                   HasShadow="False"
                   Padding="15">

                <Label x:Name="AiMessageLabel"
                       Text="Núcleo activado. Sincronizando datos con el servidor..."
                       FontSize="18"
                       TextColor="#E2E8F0"
                       FontFamily="Arial"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

            </Frame>


            <!-- ========================================= -->
            <!-- 3. LISTA DE TAREAS (PENDIENTES | COMPLETADAS) -->
            <!-- ========================================= -->

            <Grid Grid.Row="2"
                  RowDefinitions="Auto, Auto, *"
                  RowSpacing="8">

                <!-- BOTONES DE FILTRO -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*, *"
                      ColumnSpacing="12">

                    <Button x:Name="BtnFiltroPendientes"
                            Grid.Column="0"
                            Text="Pendientes (0)"
                            Clicked="OnFiltroPendientesClicked"
                            BackgroundColor="#0E7490"
                            BorderColor="#67E8F9"
                            BorderWidth="2"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="46"
                            CornerRadius="23"
                            Padding="0,0">
                        <Button.Shadow>
                            <Shadow x:Name="ShadowPendientes"
                                    Brush="#67E8F9"
                                    Opacity="0.5"
                                    Radius="14"
                                    Offset="0,0"/>
                        </Button.Shadow>
                    </Button>

                    <Button x:Name="BtnFiltroCompletadas"
                            Grid.Column="1"
                            Text="Completadas (0)"
                            Clicked="OnFiltroCompletadasClicked"
                            BackgroundColor="#111C30"
                            BorderColor="#245B78"
                            BorderWidth="1"
                            TextColor="#94A3B8"
                            FontSize="14"
                            HeightRequest="46"
                            CornerRadius="23"
                            Padding="0,0">
                        <Button.Shadow>
                            <Shadow x:Name="ShadowCompletadas"
                                    Brush="#6EE7B7"
                                    Opacity="0"
                                    Radius="14"
                                    Offset="0,0"/>
                        </Button.Shadow>
                    </Button>

                </Grid>

                <!-- CONTADOR -->
                <Label x:Name="TareasCountLabel"
                       Grid.Row="1"
                       Text="Mostrando: Pendientes"
                       FontSize="12"
                       TextColor="#64748B"
                       HorizontalOptions="Center"/>

                <!-- COLLECTIONVIEW ÚNICO -->
                <CollectionView x:Name="TasksCollectionView"
                                Grid.Row="2"
                                SelectionMode="Single"
                                SelectionChanged="OnTaskTapped">

                    <CollectionView.EmptyView>
                        <Label x:Name="EmptyViewLabel"
                               Text="Sin tareas pendientes"
                               FontSize="13"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center"
                               Margin="0,20"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Frame Margin="0,4"
                                   Padding="12"
                                   CornerRadius="8"
                                   BackgroundColor="#111827"
                                   BorderColor="#245B78">

                                <Grid ColumnDefinitions="*, Auto">

                                    <!-- Información de tarea -->
                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="3">

                                        <Label Text="{Binding Titulo}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="#E2E8F0"/>

                                        <Label Text="{Binding FechaVencimiento, StringFormat='Vence: {0:dd/MM/yyyy}'}"
                                               FontSize="11"
                                               TextColor="#64748B"/>

                                        <Label Text="{Binding FrecuenciaRecordatorioHoras, StringFormat='Recordar cada {0} horas', TargetNullValue='Sin recordatorio'}"
                                               FontSize="10"
                                               TextColor="#E2E8F0"/>

                                    </VerticalStackLayout>

                                    <!-- ============================= -->
                                    <!-- BOTONES CRUD                   -->
                                    <!-- ============================= -->

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="6">

                                        <!-- Completar / Reabrir -->
                                        <Button Text="Completar"
                                                Clicked="OnToggleCompleteClicked"
                                                BackgroundColor="#172554"
                                                BorderColor="#22D3EE"
                                                BorderWidth="1"
                                                TextColor="#22D3EE"
                                                FontSize="11"
                                                Padding="8,4"
                                                CornerRadius="4">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                             Binding="{Binding Estado}"
                                                             Value="Completado">
                                                    <Setter Property="Text" Value="Reabrir"/>
                                                    <Setter Property="BackgroundColor" Value="#052E16"/>
                                                    <Setter Property="BorderColor" Value="#34D399"/>
                                                    <Setter Property="TextColor" Value="#34D399"/>
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <!-- Editar -->
                                        <Button Text="Editar"
                                                Clicked="OnEditTaskClicked"
                                                BackgroundColor="#111C30"
                                                BorderColor="#245B78"
                                                BorderWidth="1"
                                                TextColor="#38BDF8"
                                                FontSize="11"
                                                Padding="8,4"
                                                CornerRadius="4"/>

                                        <!-- Eliminar -->
                                        <Button Text="Eliminar"
                                                Clicked="OnDeleteTaskClicked"
                                                BackgroundColor="#172554"
                                                BorderColor="#3B82F6"
                                                BorderWidth="1"
                                                TextColor="#3B82F6"
                                                FontSize="11"
                                                Padding="8,4"
                                                CornerRadius="4"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Frame>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>


            <!-- ========================================= -->
            <!-- 4. BOTONES DE ACCIÓN                       -->
            <!-- ========================================= -->

            <Grid Grid.Row="3"
                  RowDefinitions="Auto, Auto"
                  RowSpacing="10">

                <HorizontalStackLayout Spacing="12"
                                       HorizontalOptions="Center">

                    <!-- Nueva tarea -->
                    <Button Text="+ Nueva Tarea"
                            Clicked="OnAddTaskClicked"
                            BackgroundColor="#2563EB"
                            TextColor="#E2E8F0"
                            FontAttributes="Bold"
                            CornerRadius="6"/>

                   
                    <!-- Resumen -->
                    <!--        <Button Text="Resumen de hoy"
                            Clicked="OnGetSummaryClicked"
                            BackgroundColor="#172554"
                            BorderColor="#245B78"
                            BorderWidth="1"
                            TextColor="#22D3EE"
                            FontAttributes="Bold"
                            CornerRadius="6"/> -->

                    <!-- Asistente IA -->
                    <Button x:Name="AgenteBoton"
                            Text="🤖 Asistente IA"
                            Clicked="OnAgenteClicked"
                            BackgroundColor="#7C3AED"
                            BorderColor="#A78BFA"
                            BorderWidth="1"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            CornerRadius="6"/>

                </HorizontalStackLayout>


                <!-- Actualizar -->
                <Button Grid.Row="1"
                        Text="🔄 Actualizar / Sincronizar"
                        Clicked="OnRefreshClicked"
                        BackgroundColor="#172554"
                        BorderColor="#245B78"
                        BorderWidth="1"
                        TextColor="#22D3EE"
                        FontAttributes="Bold"
                        CornerRadius="6"/>

            </Grid>

        </Grid>


        <!-- ========================================= -->
        <!-- ACCESO ADMIN (ESQUINA SUP. IZQUIERDA)   -->
        <!-- ========================================= -->

        <HorizontalStackLayout
                Spacing="8"
                Margin="12,12,0,0"
                HorizontalOptions="Start"
                VerticalOptions="Start">

            <Button x:Name="AdminBoton"
                    Text="ADMIN"
                    IsVisible="False"
                    Clicked="OnAdminClicked"
                    BackgroundColor="#111C30"
                    BorderColor="#FBBF24"
                    BorderWidth="1"
                    TextColor="#FBBF24"
                    FontAttributes="Bold"
                    FontSize="14"
                    WidthRequest="72"
                    HeightRequest="34"
                    Padding="0,0"
                    CornerRadius="17"
                    ToolTipProperties.Text="Panel de administración"/>

            <Button Text="SALIR"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="#450A0A"
                    BorderColor="#F87171"
                    BorderWidth="1"
                    TextColor="#F87171"
                    FontAttributes="Bold"
                    FontSize="14"
                    WidthRequest="54"
                    HeightRequest="34"
                    Padding="0,0"
                    CornerRadius="17"
                    ToolTipProperties.Text="Cerrar sesión"/>

        </HorizontalStackLayout>


        <!-- ========================================= -->
        <!-- POPUP NUEVA TAREA / EDITAR TAREA          -->
        <!-- ========================================= -->

        <Grid x:Name="TareaPopupOverlay"
              IsVisible="False"
              BackgroundColor="#0B1120">

            <ScrollView>

                <Grid Padding="30"
                      RowSpacing="15"
                      VerticalOptions="Center"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">


                    <!-- ENCABEZADO -->
                    <Label Grid.Row="0"
                           x:Name="PopupHeaderLabel"
                           Text="Registrar Nueva Tarea"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#22D3EE"
                           HorizontalOptions="Center"/>


                    <!-- TÍTULO DE LA TAREA -->
                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="6">

                        <Label Text="Título de la tarea"
                               FontAttributes="Bold"
                               TextColor="#E2E8F0"
                               FontSize="14"/>

                        <Entry x:Name="PopupTituloEntry"
                               Placeholder="¿Qué deseas registrar?"
                               PlaceholderColor="#64748B"
                               BackgroundColor="#111C30"
                               TextColor="#E2E8F0"/>

                    </VerticalStackLayout>


                    <!-- FECHA DE VENCIMIENTO -->
                    <VerticalStackLayout Grid.Row="2"
                                         Spacing="6">

                        <Label Text="Fecha de vencimiento"
                               FontAttributes="Bold"
                               TextColor="#E2E8F0"
                               FontSize="14"/>

                        <DatePicker x:Name="PopupFechaPicker"
                                    BackgroundColor="#111C30"
                                    TextColor="#22D3EE"/>

                    </VerticalStackLayout>


                    <!-- FRECUENCIA DE RECORDATORIO -->
                    <VerticalStackLayout Grid.Row="3"
                                         Spacing="6">

                        <Label Text="Cada cuánto quieres recibir el recordatorio"
                               FontAttributes="Bold"
                               TextColor="#E2E8F0"
                               FontSize="14"/>

                        <Label Text="Selecciona la frecuencia de tus notificaciones:"
                               FontSize="12"
                               TextColor="#94A3B8"/>

                        <Picker x:Name="PopupFrecuenciaPicker"
                                BackgroundColor="#111C30"
                                Title="Frecuencia de recordatorio"
                                TextColor="#E2E8F0"/>

                    </VerticalStackLayout>


                    <!-- GUARDAR -->
                    <Button x:Name="PopupBotonGuardar"
                            Grid.Row="4"
                            Text="Guardar Tarea"
                            Clicked="OnPopupGuardarClicked"
                            BackgroundColor="#2563EB"
                            TextColor="#E2E8F0"
                            FontAttributes="Bold"
                            CornerRadius="6"/>


                    <!-- CANCELAR -->
                    <Button Grid.Row="5"
                            Text="Cancelar"
                            Clicked="OnPopupCancelarClicked"
                            BackgroundColor="#172554"
                            BorderColor="#245B78"
                            BorderWidth="1"
                            TextColor="#22D3EE"
                            CornerRadius="6"/>

                </Grid>

            </ScrollView>

        </Grid>

        <!-- ========================================= -->
        <!-- CONSOLA DEL ASISTENTE IA                  -->
        <!-- ========================================= -->

        <Grid x:Name="AgentePopupOverlay"
              IsVisible="False">

            <!-- Velo de fondo -->
            <Grid BackgroundColor="#F00B1120" />

            <Border x:Name="AgenteConsolaCard"
                    Margin="18"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="540"
                    MaximumHeightRequest="780"
                    StrokeThickness="2">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <!-- Marco neón violeta → cian -->
                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C3AED" Offset="0.0" />
                        <GradientStop Color="#A78BFA" Offset="0.4" />
                        <GradientStop Color="#22D3EE" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Stroke>

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0B1220" Offset="0.0" />
                        <GradientStop Color="#141A2E" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- ==================== -->
                    <!-- ENCABEZADO / ORBE   -->
                    <!-- ==================== -->

                    <Grid Grid.Row="0"
                          RowDefinitions="Auto,Auto">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="18,16"
                              ColumnSpacing="14">

                            <!-- Orbe del asistente: núcleo + anillos HUD -->
                            <Grid Grid.Column="0"
                                  WidthRequest="62"
                                  HeightRequest="62"
                                  HorizontalOptions="Start"
                                  VerticalOptions="Center">

                                <Ellipse x:Name="AgenteGlowOrb"
                                         WidthRequest="46"
                                         HeightRequest="46"
                                         Opacity="0.3"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                            <GradientStop Color="#A78BFA" Offset="0.0" />
                                            <GradientStop Color="#7C3AED" Offset="0.45" />
                                            <GradientStop Color="Transparent" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <Ellipse x:Name="AgenteAnilloExt"
                                         WidthRequest="60"
                                         HeightRequest="60"
                                         Stroke="#A78BFA"
                                         StrokeThickness="2"
                                         StrokeDashArray="8, 5"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />

                                <Ellipse x:Name="AgenteAnilloInt"
                                         WidthRequest="44"
                                         HeightRequest="44"
                                         Stroke="#22D3EE"
                                         StrokeThickness="1.5"
                                         StrokeDashArray="2, 4"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />

                                <Ellipse x:Name="AgenteNucleo"
                                         WidthRequest="22"
                                         HeightRequest="22"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                            <GradientStop Color="#F5D0FE" Offset="0.0" />
                                            <GradientStop Color="#A78BFA" Offset="0.5" />
                                            <GradientStop Color="#6D28D9" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Esquinas HUD del orbe -->
                                <Path Data="M 0,16 L 0,0 L 16,0
                                            M 46,0 L 62,0 L 62,16
                                            M 62,46 L 62,62 L 46,62
                                            M 16,62 L 0,62 L 0,46"
                                      Stroke="#A78BFA"
                                      StrokeThickness="1.2"
                                      Opacity="0.45"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill" />

                            </Grid>

                            <!-- Estado del agente -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">

                                <HorizontalStackLayout Spacing="8">
                                    <Ellipse x:Name="AgenteStatusDot"
                                             WidthRequest="9"
                                             HeightRequest="9"
                                             VerticalOptions="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="#34D399" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <Label x:Name="AgenteEstadoLabel"
                                           Text="NÚCLEO EN LÍNEA"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="15"
                                           CharacterSpacing="1.2"
                                           TextColor="#E2E8F0"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Label x:Name="AgenteSubEstadoLabel"
                                       Text="analizar-tareas · listo para recibir consultas"
                                       FontFamily="Monospace"
                                       FontSize="11"
                                       TextColor="#94A3B8"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />

                            </VerticalStackLayout>

                            <!-- Cerrar (esquina superior derecha) -->
                            <Button Grid.Column="2"
                                    x:Name="AgenteCerrarBotonSuperior"
                                    Text="✕"
                                    Clicked="OnAgentePopupCerrarClicked"
                                    BackgroundColor="#1E1B4B"
                                    BorderColor="#4C1D95"
                                    BorderWidth="1"
                                    TextColor="#C4B5FD"
                                    FontSize="16"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0,0"
                                    CornerRadius="20"
                                    VerticalOptions="Center"
                                    ToolTipProperties.Text="Cerrar asistente" />

                        </Grid>

                        <BoxView Grid.Row="1"
                                 HeightRequest="1"
                                 Color="#1E293B" />

                    </Grid>

                    <!-- ==================== -->
                    <!-- CUERPO DE LA CONSOLA -->
                    <!-- ==================== -->

                    <ScrollView Grid.Row="1"
                                x:Name="AgenteScrollView">

                        <VerticalStackLayout x:Name="AgenteMensajesStack"
                                             Padding="18,16"
                                             Spacing="14">

                            <!-- TARJETA PRINCIPAL: SALUDO -->
                            <Border Padding="14"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4C1D95" Offset="0.0" />
                                        <GradientStop Color="#0E7490" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Stroke>
                                <Border.Background>
                                    <SolidColorBrush Color="#111C30" />
                                </Border.Background>

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">

                                    <Border Grid.Column="0"
                                            WidthRequest="4"
                                            BackgroundColor="#A78BFA">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="2" />
                                        </Border.StrokeShape>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="8">

                                        <Label Text="{Binding Saludo}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               TextColor="#E2E8F0"
                                               LineBreakMode="WordWrap"
                                               MaxLines="0" />

                                        <Label Text="{Binding SaludoDetalle}"
                                               FontSize="12"
                                               TextColor="#94A3B8"
                                               LineBreakMode="WordWrap"
                                               MaxLines="0" />

                                    </VerticalStackLayout>

                                </Grid>
                            </Border>

                            <!-- TARJETA: EL AGENTE ESTÁ PENSANDO -->
                            <Border x:Name="AgentePensandoCard"
                                    IsVisible="False"
                                    Padding="14"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Stroke>
                                    <SolidColorBrush Color="#312E81" />
                                </Border.Stroke>
                                <Border.Background>
                                    <SolidColorBrush Color="#0F172A" />
                                </Border.Background>

                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10">

                                        <HorizontalStackLayout Grid.Column="0"
                                                               Spacing="5"
                                                               VerticalOptions="Center">
                                            <Ellipse x:Name="AgentePunto1"
                                                     WidthRequest="8"
                                                     HeightRequest="8"
                                                     Opacity="1"
                                                     Fill="#A78BFA" />
                                            <Ellipse x:Name="AgentePunto2"
                                                     WidthRequest="8"
                                                     HeightRequest="8"
                                                     Opacity="0.25"
                                                     Fill="#A78BFA" />
                                            <Ellipse x:Name="AgentePunto3"
                                                     WidthRequest="8"
                                                     HeightRequest="8"
                                                     Opacity="0.25"
                                                     Fill="#A78BFA" />
                                        </HorizontalStackLayout>

                                        <Label Grid.Column="1"
                                               x:Name="AgenteProgresoLabel"
                                               Text="Analizando tus tareas..."
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13"
                                               TextColor="#C4B5FD"
                                               LineBreakMode="WordWrap"
                                               MaxLines="0"
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="2"
                                               Text="IA"
                                               FontFamily="Monospace"
                                               FontSize="10"
                                               CharacterSpacing="1"
                                               TextColor="#6366F1"
                                               VerticalOptions="Center" />

                                    </Grid>

                                    <ProgressBar x:Name="AgenteProgresoBar"
                                                 Progress="0.15"
                                                 ProgressColor="#A78BFA"
                                                 HeightRequest="4" />

                                    <Label x:Name="AgenteLogLabel"
                                           FontFamily="Monospace"
                                           FontSize="10"
                                           TextColor="#475569"
                                           LineBreakMode="WordWrap"
                                           MaxLines="0" />

                                </VerticalStackLayout>
                            </Border>

                            <!-- TARJETA: TAREAS VENCIDAS (NO TERMINADAS) -->
                            <Border x:Name="AgenteVencidasCard"
                                    IsVisible="False"
                                    Padding="16"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#B45309" Offset="0.0" />
                                        <GradientStop Color="#991B1B" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Stroke>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1C120D" Offset="0.0" />
                                        <GradientStop Color="#140C12" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10">

                                        <Label Grid.Column="0"
                                               Text="⏰"
                                               FontSize="15"
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="1"
                                               Text="TAREAS VENCIDAS"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               CharacterSpacing="1.4"
                                               TextColor="#FBBF24"
                                               VerticalOptions="Center" />

                                        <Border Grid.Column="2"
                                                Padding="8,2"
                                                BackgroundColor="#7F1D1D"
                                                Stroke="#F87171"
                                                StrokeThickness="1"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label x:Name="AgenteVencidasContador"
                                                   Text="0"
                                                   FontFamily="Monospace"
                                                   FontSize="11"
                                                   TextColor="#FECACA"
                                                   VerticalOptions="Center" />
                                        </Border>

                                    </Grid>

                                    <Label x:Name="AgenteVencidasAviso"
                                           Text="Pasaron su fecha de vencimiento y siguen sin completarse."
                                           FontSize="11"
                                           TextColor="#FBBF24"
                                           LineBreakMode="WordWrap"
                                           MaxLines="0" />

                                    <VerticalStackLayout x:Name="AgenteVencidasStack"
                                                         BindableLayout.ItemsSource="{Binding Vencidas}"
                                                         Spacing="8">

                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10"
                                                        BackgroundColor="#0F0A0C"
                                                        Stroke="#4C1D1D"
                                                        StrokeThickness="1">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="10">

                                                        <Border Grid.Column="0"
                                                                WidthRequest="30"
                                                                HeightRequest="30"
                                                                BackgroundColor="#450A0A"
                                                                Stroke="#B45309"
                                                                StrokeThickness="1"
                                                                VerticalOptions="Start">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding Numero}"
                                                                   FontFamily="Monospace"
                                                                   FontSize="11"
                                                                   TextColor="#FCA5A5"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="5">

                                                            <Label Text="{Binding Titulo}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="#E2E8F0"
                                                                   LineBreakMode="WordWrap"
                                                                   MaxLines="0" />

                                                            <Grid ColumnDefinitions="*,Auto"
                                                                  ColumnSpacing="8">

                                                                <Label Grid.Column="0"
                                                                       Text="{Binding Detalle}"
                                                                       FontFamily="Monospace"
                                                                       FontSize="10"
                                                                       TextColor="#F87171"
                                                                       LineBreakMode="WordWrap"
                                                                       MaxLines="0"
                                                                       VerticalOptions="Center" />

                                                                <Border Grid.Column="1"
                                                                        Padding="7,1"
                                                                        BackgroundColor="#450A0A"
                                                                        Stroke="#7F1D1D"
                                                                        StrokeThickness="1"
                                                                        VerticalOptions="Center">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="6" />
                                                                    </Border.StrokeShape>
                                                                    <Label Text="NO TERMINADA"
                                                                           FontSize="8"
                                                                           CharacterSpacing="0.8"
                                                                           TextColor="#FCA5A5"
                                                                           VerticalOptions="Center" />
                                                                </Border>

                                                            </Grid>

                                                        </VerticalStackLayout>

                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>

                            <!-- TARJETA: CONTADOR DE PENDIENTES -->
                            <Border x:Name="AgenteContadorCard"
                                    IsVisible="False"
                                    Padding="16"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7C3AED" Offset="0.0" />
                                        <GradientStop Color="#22D3EE" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Stroke>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E1B4B" Offset="0.0" />
                                        <GradientStop Color="#0F172A" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid ColumnDefinitions="Auto,Auto,*"
                                      ColumnSpacing="16">

                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="0"
                                                         HorizontalOptions="Center">

                                        <Label x:Name="AgenteContadorNumero"
                                               Text="0"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="40"
                                               TextColor="#C4B5FD"
                                               HorizontalTextAlignment="Center" />

                                        <Label Text="PENDIENTES"
                                               FontSize="9"
                                               CharacterSpacing="1.6"
                                               TextColor="#94A3B8"
                                               HorizontalTextAlignment="Center" />

                                    </VerticalStackLayout>

                                    <BoxView Grid.Column="1"
                                             WidthRequest="1"
                                             Color="#312E81" />

                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="5"
                                                         VerticalOptions="Center">

                                        <Label x:Name="AgenteContadorTitulo"
                                               Text="ESTADO DE TUS TAREAS"
                                               FontSize="10"
                                               CharacterSpacing="1.4"
                                               TextColor="#67E8F9"
                                               LineBreakMode="WordWrap"
                                               MaxLines="0" />

                                        <Label x:Name="AgenteContadorDetalle"
                                               Text="El agente revisó tu lista completa."
                                               FontSize="12"
                                               TextColor="#94A3B8"
                                               LineBreakMode="WordWrap"
                                               MaxLines="0" />

                                    </VerticalStackLayout>

                                </Grid>
                            </Border>

                            <!-- TARJETA: PLAN DE ACCIÓN -->
                            <Border x:Name="AgentePlanCard"
                                    IsVisible="False"
                                    Padding="16"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Stroke>
                                    <SolidColorBrush Color="#155E75" />
                                </Border.Stroke>
                                <Border.Background>
                                    <SolidColorBrush Color="#0C1626" />
                                </Border.Background>

                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="10">

                                        <Label Grid.Column="0"
                                               Text="📋"
                                               FontSize="15"
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="1"
                                               Text="PLAN DE ACCIÓN"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               CharacterSpacing="1.4"
                                               TextColor="#67E8F9"
                                               VerticalOptions="Center" />

                                    </Grid>

                                    <Label x:Name="AgentePlanLabel"
                                           Text="{Binding Plan}"
                                           FontSize="13"
                                           TextColor="#CBD5E1"
                                           LineBreakMode="WordWrap"
                                           MaxLines="0" />

                                </VerticalStackLayout>
                            </Border>

                            <!-- CABECERA DE PRIORIDADES -->
                            <Grid x:Name="AgentePrioridadesCabecera"
                                  IsVisible="False"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="🎯"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="PRIORIDADES DEL AGENTE"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       CharacterSpacing="1.4"
                                       TextColor="#A78BFA"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- TARJETAS DE PRIORIDAD (generadas por código) -->
                            <VerticalStackLayout x:Name="AgentePrioridadesStack"
                                                 BindableLayout.ItemsSource="{Binding Prioridades}"
                                                 Spacing="10">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12"
                                                StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.Stroke>
                                                <SolidColorBrush Color="#243B57" />
                                            </Border.Stroke>
                                            <Border.Background>
                                                <SolidColorBrush Color="#0F172A" />
                                            </Border.Background>

                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="12">

                                                <Border Grid.Column="0"
                                                        WidthRequest="34"
                                                        HeightRequest="34"
                                                        BackgroundColor="#1E1B4B"
                                                        Stroke="#7C3AED"
                                                        StrokeThickness="1"
                                                        VerticalOptions="Start">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Numero}"
                                                           FontFamily="Monospace"
                                                           FontSize="13"
                                                           TextColor="#C4B5FD"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="4">

                                                    <Label Text="{Binding Titulo}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="14"
                                                           TextColor="#E2E8F0"
                                                           LineBreakMode="WordWrap"
                                                           MaxLines="0" />

                                                    <Label Text="{Binding Razon}"
                                                           FontSize="11"
                                                           TextColor="#94A3B8"
                                                           LineBreakMode="WordWrap"
                                                           MaxLines="0" />

                                                </VerticalStackLayout>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                            <!-- TARJETA: ERROR DE ENLACE -->
                            <Border x:Name="AgenteErrorCard"
                                    IsVisible="False"
                                    Padding="14"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Stroke>
                                    <SolidColorBrush Color="#7F1D1D" />
                                </Border.Stroke>
                                <Border.Background>
                                    <SolidColorBrush Color="#1F1013" />
                                </Border.Background>

                                <VerticalStackLayout Spacing="8">

                                    <Label Text="⚠ ENLACE INTERRUMPIDO"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           CharacterSpacing="1.4"
                                           TextColor="#F87171" />

                                    <Label x:Name="AgenteErrorLabel"
                                           FontSize="13"
                                           TextColor="#FECACA"
                                           LineBreakMode="WordWrap"
                                           MaxLines="0" />

                                    <Label Text="Pulsa «Analizar de nuevo» para reintentar."
                                           FontSize="11"
                                           TextColor="#94A3B8" />

                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- ==================== -->
                    <!-- PIE / ACCIONES       -->
                    <!-- ==================== -->

                    <Grid Grid.Row="2"
                          Padding="16,12"
                          RowSpacing="10"
                          RowDefinitions="Auto,Auto">

                        <BoxView Grid.Row="0"
                                 HeightRequest="1"
                                 Color="#1E293B" />

                        <HorizontalStackLayout Grid.Row="1"
                                               Spacing="10"
                                               HorizontalOptions="Fill">

                            <Button x:Name="AgenteBotonReanalizar"
                                    Text="⟳  Analizar de nuevo"
                                    Clicked="OnAgenteReanalizarClicked"
                                    BackgroundColor="#6D28D9"
                                    BorderColor="#A78BFA"
                                    BorderWidth="1"
                                    TextColor="#F5D0FE"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    HeightRequest="46"
                                    Padding="16,0"
                                    CornerRadius="23"
                                    HorizontalOptions="Fill" />

                            <Button x:Name="AgenteCerrarBoton"
                                    Text="✕  Cerrar"
                                    Clicked="OnAgentePopupCerrarClicked"
                                    BackgroundColor="#0B1220"
                                    BorderColor="#245B78"
                                    BorderWidth="1"
                                    TextColor="#22D3EE"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    HeightRequest="46"
                                    Padding="16,0"
                                    CornerRadius="23" />

                        </HorizontalStackLayout>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>